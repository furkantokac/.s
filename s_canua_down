#!/usr/bin/env bash
# Take the uaLink bus down and hand the adapter back to the browser.
# Usage: s_canua_down [iface]
# Example: s_canua_down
# Example: s_canua_down can0

set -euo pipefail

UALINK="$HOME/Git/uap/viber/scripts/ualink.sh"
if [ ! -f "$UALINK" ]; then
  echo "ualink.sh not found: $UALINK" >&2
  exit 1
fi

"$UALINK" down "$@" || true
exec "$UALINK" release "$@"
